# VigilAI Configuration
# Copy to .env and modify values. Never commit a real .env file.
#
# This file has two sections:
#   1. LOCAL / DEVELOPMENT  — safe defaults, used by `docker compose up`
#   2. PRODUCTION REQUIRED  — must be set with real values before running
#      `docker compose -f docker-compose.yml -f docker-compose.prod.yml up`
#      (that overlay fails to start if any of these are missing/placeholder)

# =============================================================================
# LOCAL / DEVELOPMENT
# =============================================================================

# Database (docker-compose.yml uses POSTGRES_USER/PASSWORD/DB to build these
# inside the containers; these DATABASE_URL values are for running the API
# directly on the host, outside Docker)
DATABASE_URL=postgresql+asyncpg://vigilai:vigilai_dev@localhost:5432/vigilai
DATABASE_SYNC_URL=postgresql+psycopg2://vigilai:vigilai_dev@localhost:5432/vigilai
POSTGRES_USER=vigilai
POSTGRES_PASSWORD=vigilai_dev
POSTGRES_DB=vigilai
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Security — INSECURE DEFAULTS, fine for local dev only.
# Production values are required below and must NOT reuse these.
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
EVIDENCE_DIR=./evidence
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Model
YOLO_MODEL_PATH=yolov8n.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMG_SIZE=640

# Worker
WORKER_HEARTBEAT_INTERVAL=5
MAX_CAMERAS_PER_WORKER=4
FRAME_QUEUE_SIZE=30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Frontend URL
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000

# =============================================================================
# PRODUCTION REQUIRED
# =============================================================================
# Only used with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Setting ENVIRONMENT=production activates strict validation: SECRET_KEY and
# ENCRYPTION_KEY are rejected if missing, too short, or a known placeholder.
# CORS_ORIGINS/FRONTEND_URL are derived automatically from DOMAIN unless you
# set them explicitly.

# ENVIRONMENT=production

# Public domain name this deployment is served from (DNS A/AAAA record must
# already point at the VPS before starting Caddy, or certificate issuance
# will fail).
# DOMAIN=example.com

# Email Caddy uses for Let's Encrypt expiry notices (optional but recommended).
# ACME_EMAIL=you@example.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up together with the database. Losing or rotating it makes
# already-stored RTSP camera credentials unreadable.
# ENCRYPTION_KEY=

# Generate with: openssl rand -hex 24
# POSTGRES_PASSWORD=
