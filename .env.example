# VigilAI Configuration
# Copy to .env and modify values

# Database
DATABASE_URL=postgresql+asyncpg://vigilai:vigilai_dev@localhost:5432/vigilai
DATABASE_SYNC_URL=postgresql://vigilai:vigilai_dev@localhost:5432/vigilai

# Redis  
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-this-to-a-32-byte-base64-key

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage
EVIDENCE_DIR=./evidence
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Model
YOLO_MODEL_PATH=yolov8n.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMG_SIZE=640

# Worker
WORKER_HEARTBEAT_INTERVAL=5
MAX_CAMERAS_PER_WORKER=4
FRAME_QUEUE_SIZE=30

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development

# Frontend URL
FRONTEND_URL=http://localhost:3000
